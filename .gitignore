# Build output
target/
*.class

# Maven wrapper leaves these behind locally; the wrapper scripts/jar themselves stay tracked
.mvn/wrapper/maven-wrapper.jar.sha256

# IDE
.idea/
*.iml
*.iws
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local env / secrets - never commit real credentials or key material
.env
.env.local
*.pem
*.pem.b64
*.key

# Local-only property overrides, if you ever add one
application-local.properties
application.properties
application-dev.properties
application-prod.properties